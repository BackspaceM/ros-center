{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ROS Center desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:app:allow-exit"
  ]
