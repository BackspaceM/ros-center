{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROS Center",
  "version": "1.1.41",
  "identifier": "cn.roscenter.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:10086",
    "beforeBuildCommand": "",
    "frontendDist": "../dist/tauri-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ROS Center",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "nsis", "app", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../dist/tauri-assets/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
