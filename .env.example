# 外部访问端口 : 容器内监听端口（默认 10086:10086；两者可分别修改）
WEB_PORT=10086
CONTAINER_PORT=10086

# 第一台 RouterOS 的初始配置（首次启动后可在 WebUI「系统管理 → 设备管理」里
# 新增/编辑多台设备，配置保存在 ./data/devices.json，优先级高于下面的环境变量）。
# 多设备只需在网页里添加，无需在 .env 里写多份。
ROS_HOST=192.168.88.1

# 8728 = API 明文；8729 = API-SSL。安全建议：仅在内网使用，或用防火墙限制来源 IP
ROS_PORT=8728
ROS_TLS=0

# 只读账号：在 RouterOS 上单独创建，只授予 read 权限
# /user group add name=monitor policy=read,api
# /user add name=monitor group=monitor password=改成强密码
ROS_USER=monitor
ROS_PASSWORD=change-me

# 实时流量：1 = RouterOS 原生 monitor-traffic 流式推送（设备每秒主动推送，推荐）
# 流式不可用时自动回退轮询，每 10 秒重试；0 = 强制只用轮询
TRAFFIC_STREAM=1
TRAFFIC_STREAM_RETRY_MS=10000
# 轮询 / 系统资源刷新间隔（毫秒，最低 500），图表保留点数（180 点 × 1 秒 ≈ 3 分钟）
POLL_INTERVAL_MS=1000
# 连接数统计刷新间隔（毫秒，最低 3000；连接表 count-only 比流量采样重）
CONN_POLL_INTERVAL_MS=5000
HISTORY_POINTS=180

# 1 = 强制演示数据，不连接路由器
DEMO_MODE=0

# 推荐：在 WebUI「系统管理 → 设备管理」里填写每台设备的地址/账号/密码，
# 保存后写入 ./data/devices.json，可管控多台路由器，优先级高于上面的环境变量。
# 镜像名（默认使用已发布到 Docker Hub 的官方镜像；自行构建后改成自己的账号）
DOCKER_IMAGE=backspacem/ros-center:latest

# 可选：WebUI 登录账号密码（留空则免登录，仅限内网使用）
# 启用后访问会跳转到 /login.html，用会话 Cookie 登录；原有 Basic Auth 仍然兼容。
# 也可以在网页「系统管理 → 设备管理 → 安全建议」里直接设置，网页设置优先级更高，
# 密码仅以 scrypt 哈希保存到 ./data/auth.json。
WEB_USER=
WEB_PASSWORD=
