# 外部访问端口 : 容器内监听端口（默认 10086:10086；两者可分别修改）
WEB_PORT=10086
CONTAINER_PORT=10086

# 第一台 RouterOS 的初始配置（首次启动后可在 WebUI「系统管理 → 设备管理」里
# 新增/编辑多台设备，配置保存在 ./data/devices.json，优先级高于下面的环境变量）。
# 多设备只需在网页里添加，无需在 .env 里写多份。
ROS_HOST=192.168.88.1

# 8728 = API 明文；8729 = API-SSL。安全建议：仅在内网使用，或用防火墙限制来源 IP
ROS_PORT=8728
ROS_TLS=0

# 只读账号：在 RouterOS 上单独创建，只授予 read 权限
# /user group add name=monitor policy=read,api
# /user add name=monitor group=monitor password=改成强密码
ROS_USER=monitor
ROS_PASSWORD=change-me

# 实时流量：1 = RouterOS 原生 monitor-traffic 流式推送（设备每秒主动推送，推荐）
# 流式不可用时自动回退轮询，每 10 秒重试；0 = 强制只用轮询
TRAFFIC_STREAM=1
TRAFFIC_STREAM_RETRY_MS=10000
# 轮询 / 系统资源刷新间隔（毫秒，最低 500），图表保留点数（180 点 × 1 秒 ≈ 3 分钟）
POLL_INTERVAL_MS=1000
# 连接数统计刷新间隔（毫秒，最低 3000；连接表 count-only 比流量采样重）
CONN_POLL_INTERVAL_MS=5000
HISTORY_POINTS=180

# 默认 0 = 启动即连接真实路由器。设为 1 仅用于界面预览：
# 页面会明确标注「演示 DEMO」，且流量统计不会写入任何演示数据；
# 路由器连不上时显示「离线 OFFLINE」，不会注入假数据或估算值。
DEMO_MODE=0

# 可选：设备凭据加密密钥（AES-256-GCM）。留空则自动生成并保存到
# ./data/secret.key；容器重建或只挂载部分数据卷时建议显式设置，
# 否则密钥丢失需要重新录入各设备密码。更换此值后旧密文无法解密。
# ROS_CENTER_KEY=

# 推荐：在 WebUI「系统管理 → 设备管理」里填写每台设备的地址/账号/密码，
# 保存后写入 ./data/devices.json，可管控多台路由器，优先级高于上面的环境变量。
# 镜像名（默认使用已发布到 Docker Hub 的官方镜像；自行构建后改成自己的账号）
DOCKER_IMAGE=backspacem/ros-center:latest

# 可选：WebUI 登录账号密码（留空则免登录，仅限内网使用）
# 启用后访问会跳转到 /login.html，用会话 Cookie 登录；原有 Basic Auth 仍然兼容。
# 也可以在网页「系统管理 → 设备管理 → 安全建议」里直接设置，网页设置优先级更高，
# 密码仅以 scrypt 哈希保存到 ./data/auth.json。
WEB_USER=
WEB_PASSWORD=

# ---- 检查更新（也可在 WebUI「系统管理 → 检查更新」里配置，网页设置优先）----
# 检测源：github（GitHub Releases，默认）或 dockerhub（镜像 tag）。
# Docker Hub / GitHub API 在受限网络下可指定代理或镜像源反代：
#   ROS_UPDATE_PROXY=http://user:pass@127.0.0.1:7890   （HTTP CONNECT 代理）
#   ROS_UPDATE_ENDPOINT=https://mirror.example.com/v2/repositories/backspacem/ros-center/tags/latest
# 说明：endpoint 是「完整 API 地址」，需返回与官方接口同结构的 JSON。
# ROS_UPDATE_ENABLED=0  关闭服务端定时检查（默认开启）
# ROS_UPDATE_SOURCE=github
# ROS_UPDATE_INTERVAL=24  检查周期（小时）
# ROS_UPDATE_IMAGE=backspacem/ros-center
# ROS_CENTER_VERSION=1.0.0      当前版本号（默认读 package.json / version.json）
# ROS_CENTER_DIGEST=sha256:...  当前镜像 digest，Docker Hub 源据此比对
#
# ---- 应用内自动更新（无需重装 / 无需手动敲 docker 命令）----
# Docker：在 docker-compose.yml 的 volumes 里额外映射 /var/run/docker.sock，
#   程序即可拉取新镜像并按原配置重建容器（仅 restart 不会换镜像）。
#   注意：映射 docker.sock 等于把宿主机 Docker 控制权交给容器，请自行评估风险。
# ROS_DOCKER_SOCKET=/var/run/docker.sock
# ROS_DOCKER_CONTAINER=ros-center   容器名或 ID；留空则用 hostname 自动识别
# ROS_UPDATE_AUTO_APPLY=1          发现新版本后自动应用（Docker 重建 / 桌面替换并重启）
# 桌面版：无需额外配置；首次安装带 launcher 的版本后，网页里点「一键更新并重启」即可，
#   以后都不用再下载 pkg/dmg/exe。更新包是 ros-center-app-*.zip（仅源码，约 200KB）。

