# 外部访问端口 : 容器内监听端口（改容器端口后两者要同步）
WEB_PORT=3000
CONTAINER_PORT=3000

# RouterOS 地址（API 服务所在 IP）
ROS_HOST=192.168.88.1

# 8728 = API 明文；8729 = API-SSL。安全建议：仅在内网使用，或用防火墙限制来源 IP
ROS_PORT=8728
ROS_TLS=0

# 只读账号：在 RouterOS 上单独创建，只授予 read 权限
# /user group add name=monitor policy=read,api
# /user add name=monitor group=monitor password=改成强密码
ROS_USER=monitor
ROS_PASSWORD=change-me

# 采样间隔（毫秒）与图表保留点数（180 点 × 2 秒 ≈ 6 分钟）
POLL_INTERVAL_MS=2000
HISTORY_POINTS=180

# 1 = 强制演示数据，不连接路由器
DEMO_MODE=0

# 也可以在 WebUI 的「系统管理 → 连接设置」里直接填写地址/账号/密码，
# 保存后写入 ./data/settings.json，优先级高于上面的环境变量，无需改本文件。
# 镜像名（推送到 Docker Hub 后改成自己的账号）
DOCKER_IMAGE=ros-traffic-webui:latest

# 可选：给 WebUI 本身加一层 Basic 登录（留空则免登录，仅限内网使用）
WEB_USER=
WEB_PASSWORD=
